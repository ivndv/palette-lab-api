# Variables de entorno de palette-lab-api
# Copia este archivo a `.env` y rellena los valores.
# `.env*` está en .gitignore: los secretos NUNCA se suben.

# ---- Groq (solo aquí, nunca en el frontend) ----
GROQ_API_KEY=

# ---- Secreto compartido con el BFF de Cloudflare Pages ----
PALETTE_LAB_API_KEY=

# ---- Límites ----
RATE_LIMIT_PER_MIN=10
RATE_LIMIT_PER_DAY=100

# ---- Solo desarrollo: no llama a Groq ----
MOCK_AI=false

# ---- Cache de respuestas ----
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400
CACHE_MAX_ENTRIES=500

# ---- Upstash Redis (cache + rate limit) ----
# Si faltan URL o token, ambos usan memoria.
# Usa HTTPS. Ejemplo: https://tu-base.upstash.io
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_TIMEOUT_SECONDS=1.5
APP_NAMESPACE=palette
APP_ENV=local
CACHE_BACKEND=upstash
RATE_LIMIT_BACKEND=upstash
RATE_LIMIT_GLOBAL_PER_DAY=800

# ---- CORS (defensivo: el BFF llama desde el servidor) ----
ALLOWED_ORIGINS=http://localhost:5173
